# Environment variables for BeerTracker
# ⚠️  This file contains secrets. Run: chmod 600 .env
# ⚠️  .env is gitignored — never commit it or share these values.

# Zettle API credentials for LaBamba (required)
# The client ID is not secret but should be kept alongside the assertion key.
BEERTRACKER_ZETTLE_CLIENT_ID=e8339854-d24e-11ed-bab2-c90128e9ad74
# The assertion key is a long JWT string. Get it from your Zettle developer dashboard
# or the existing Java TokenGetter.java source if you have access.
BEERTRACKER_ZETTLE_ASSERTION_KEY=

# Firebase service account JSON path (default: firebase-service-account.json)
# In Docker, this should point to the mounted file inside the container
BEERTRACKER_FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json

# Sync interval in seconds (default: 60)
BEERTRACKER_SYNC_INTERVAL_SECONDS=60

# Token refresh interval in minutes (default: 30)
BEERTRACKER_TOKEN_REFRESH_MINUTES=30

# Logging level: DEBUG, INFO, WARNING, ERROR (default: INFO)
BEERTRACKER_LOG_LEVEL=INFO
